{
    "name": "infrangible/m2-backend-widget",
    "description": "Shared admin building blocks for Infrangible modules: data grids with selectable columns and CSV export, edit forms, tabs and special input fields.",
    "type": "magento2-module",
    "version": "4.0.5",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Admin tools"
    ],
    "homepage": "https://www.infrangible.dev/modules/backend-widget",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@infrangible.dev",
            "homepage": "https://www.infrangible.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "fewedev/base": "~2.4.0",
        "infrangible/m2-core": "~5.0.0",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "magento/module-backend": "~102.0.0",
        "magento/module-catalog": "~104.0.0",
        "magento/module-cms": "~104.0.0",
        "magento/module-config": "~101.2.0",
        "magento/module-customer": "~103.0.0",
        "magento/module-directory": "~100.4.0",
        "magento/module-eav": "~102.1.0",
        "magento/module-email": "~101.1.0",
        "magento/module-store": "~101.1.0",
        "magento/module-theme": "~101.1.0",
        "magento/module-ui": "~101.2.0",
        "magento/zend-db": "~1.16.0",
        "psr/log": "~1.1.0||~2.0.0||~3.0.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\BackendWidget\\": "src"
        }
    }
}
