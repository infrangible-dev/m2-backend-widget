<?php /** @var Php $this */ ?>
<?php /** @var Add $block */ ?>
<?php /** @var Escaper $escaper */ ?>

<script>
    require(['jquery'], function ($) {
        $('#<?= $escaper->escapeJs($block->getButtonId()) ?>').on('click', function () {
            const grid = $('#<?= $escaper->escapeJs($block->getGridId()) ?>').parent();
            $.ajax({
                url: '<?= $escaper->escapeJs($block->getButtonUrl()) ?>',
                method: 'get',
                dataType: 'html',
                showLoader: true,
                context: grid[0],
                success: function (data) {
                    const targetNode = grid;
                    targetNode.html(data);
                    targetNode.trigger('contentUpdated');
                }
            });
        });
    });
</script>
