/** @var Tab $block */
/** @var Escaper $escaper */
?>

<div id="<?= $escaper->escapeHtmlAttr($block->getTabId()) ?>"></div>

<script>
    require(['jquery'], function ($) {
        const productTab = $('#<?= $escaper->escapeJs($block->getTabId()) ?>');
        $.ajax({
            url: '<?= $escaper->escapeJs($block->getTabUrl()) ?>',
            method: 'get',
            dataType: 'html',
            showLoader: true,
            context: productTab[0],
            success: function (data) {
                const targetNode = productTab;
                targetNode.html(data);
                targetNode.trigger('contentUpdated');
            }
        });
    });
</script>
