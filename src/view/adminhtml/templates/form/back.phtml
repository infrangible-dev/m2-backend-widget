/** @var Php $this */
/** @var Back $block */
/** @var Escaper $escaper */
?>

<script>
    require(['jquery'], function ($) {
        $('#<?= $escaper->escapeJs($block->getButtonId()) ?>').on('click', function () {
            const editForm = $('#<?= $escaper->escapeJs($block->getFormId()) ?>');
            const editFormParent = editForm.parent().parent();
            editForm.notification();
            editForm.notification('clear');
            $.ajax({
                url: '<?= $escaper->escapeJs($block->getButtonUrl()) ?>',
                method: 'get',
                dataType: 'html',
                showLoader: true,
                context: editFormParent[0],
                success: function (data) {
                    const targetNode = editFormParent;
                    targetNode.html(data);
                    targetNode.trigger('contentUpdated');
                }
            });
        });
    });
</script>
